# CDSE Stats — Environment configuration
# Copy to .env and adapt for your deployment.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Session — MUST be a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-secret

# Session inactivity timeout in minutes
SESSION_TIMEOUT_MIN=60

# Database file path (relative to project root)
DB_PATH=./data/cdse.db

# Backup configuration
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
# Cron schedule for automatic backups (default: every day at 02:30)
BACKUP_CRON=30 2 * * *

# Optional: AES-256-GCM encryption-at-rest for nom/prenom fields.
# Disabled for MVP. To enable later, set ENCRYPT_PII=1 and provide a 32-byte
# base64 key (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))").
ENCRYPT_PII=0
PII_KEY=

# Trust proxy (set to 1 when running behind a reverse proxy like Caddy/Nginx)
TRUST_PROXY=0

# Cookie security: set to 1 when the proxy terminates HTTPS
COOKIE_SECURE=0
